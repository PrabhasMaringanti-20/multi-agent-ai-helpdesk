# =============================================================================
# Enterprise Multi-Agent AI Helpdesk Platform - backend environment template
# Copy to `.env` and override. NEVER commit a real `.env`.
# Consumed by app/core/config.py (Pydantic Settings, 12-factor).
# In docker-compose, host values (postgres/redis/chromadb) are overridden per
# service; keep localhost here for local (non-docker) runs.
# =============================================================================

# ---- Application ----
APP_NAME="Enterprise Multi-Agent AI Helpdesk Platform"
APP_ENV=local                 # local | development | staging | production
API_V1_PREFIX=/api/v1
VERSION=1.0.0

# ---- Security / JWT (REQUIRED: strong random >=32 chars in production) ----
SECRET_KEY=change-me-please-use-a-32char-min-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
JWT_ISSUER=helpdesk-platform
JWT_AUDIENCE=helpdesk-clients

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=helpdesk
POSTGRES_DB=helpdesk
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# ---- Redis (answer cache, hot memory, rate limits, jti denylist) ----
REDIS_URL=redis://localhost:6379/0

# ---- Celery (Redis broker + result backend) ----
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- ChromaDB (dense vector store) ----
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_KB_COLLECTION=kb_chunks
CHROMA_KB_PENDING_COLLECTION=kb_chunks_pending

# ---- LLM / Embedding provider selection (abstract; swappable) ----
LLM_PROVIDER=gemini           # gemini | openai | claude | fake
EMBEDDING_PROVIDER=gemini     # gemini | openai | fake

# ---- Gemini ----
GEMINI_API_KEY=
LLM_SMALL_MODEL=gemini-1.5-flash
LLM_LARGE_MODEL=gemini-1.5-pro
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768

# ---- OpenAI (used when *_PROVIDER=openai) ----
OPENAI_API_KEY=
OPENAI_SMALL_MODEL=gpt-4o-mini
OPENAI_LARGE_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Anthropic / Claude (used when LLM_PROVIDER=claude) ----
ANTHROPIC_API_KEY=
ANTHROPIC_SMALL_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_LARGE_MODEL=claude-sonnet-5

# ---- Generation defaults + resilience ----
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=0.5
LLM_RATE_LIMIT_PER_MINUTE=300

# ---- Retrieval + memory ----
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATE_K=20
MEMORY_WINDOW_TURNS=10
MEMORY_SUMMARY_TRIGGER_TURNS=12

# ---- CORS (comma-separated origins) ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Rate limiting ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# ---- Logging ----
LOG_LEVEL=INFO
LOG_JSON=true

# ---- Demo bootstrap (dev/demo only; the entrypoint seeds an org + admin when true) ----
BOOTSTRAP_DEMO=false
BOOTSTRAP_ORG_SLUG=acme
BOOTSTRAP_ORG_NAME=Acme Corp
BOOTSTRAP_ADMIN_EMAIL=admin@acme.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
